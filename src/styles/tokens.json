{
  "$schema": "https://design-tokens.github.io/community-group/format/schema.json",

  "color": {
    "primary": {
      "$type": "color",
      "$value": "var(--color-primary)"
    },
    "primary-50": {
      "$type": "color",
      "$value": "var(--color-primary-50)"
    },
    "primary-100": {
      "$type": "color",
      "$value": "var(--color-primary-100)"
    },

    "success": {
      "$type": "color",
      "$value": "var(--color-success)"
    },
    "success-50": {
      "$type": "color",
      "$value": "var(--color-success-50)"
    },

    "danger": {
      "$type": "color",
      "$value": "var(--color-danger)"
    },
    "danger-50": {
      "$type": "color",
      "$value": "var(--color-danger-50)"
    },

    "info": {
      "$type": "color",
      "$value": "var(--color-blue)"
    },
    "info-50": {
      "$type": "color",
      "$value": "var(--color-blue-50)"
    },

    "text": {
      "dark": {
        "$type": "color",
        "$value": "var(--color-text-dark)"
      },
      "light": {
        "$type": "color",
        "$value": "var(--color-text-light)"
      }
    },

    "neutral": {
      "50": {
        "$type": "color",
        "$value": "var(--color-neutralColor50)"
      }
    }
  },

  "size": {
    "xs": { "$value": "0.75rem" },
    "sm": { "$value": "1rem" },
    "md": { "$value": "1.25rem" },
    "lg": { "$value": "1.75rem" },
    "xl": { "$value": "2.25rem" }
  },

  "spacing": {
    "xs": { "$value": "4px" },
    "sm": { "$value": "8px" },
    "md": { "$value": "12px" },
    "lg": { "$value": "16px" },
    "xl": { "$value": "24px" }
  },

  "borderRadius": {
    "none": { "$value": "0px" },
    "sm": { "$value": "4px" },
    "md": { "$value": "6px" },
    "lg": { "$value": "12px" },
    "full": { "$value": "9999px" }
  },

  "borderWidth": {
    "default": { "$value": "1px" },
    "thick": { "$value": "2px" }
  },

  "component": {
    "button": {
      "padding": {
        "xs": { "$value": "{spacing.xs} {spacing.sm}" },
        "sm": { "$value": "{spacing.sm} {spacing.md}" },
        "md": { "$value": "10px 20px" },
        "lg": { "$value": "{spacing.md} {spacing.lg}" }
      },
      "fontSize": {
        "xs": { "$value": "0.75rem" },
        "sm": { "$value": "0.875rem" },
        "md": { "$value": "0.875rem" },
        "lg": { "$value": "1rem" }
      }
    },

    "checkbox": {
      "size": {
        "sm": { "$value": "14px" },
        "md": { "$value": "16px" },
        "lg": { "$value": "20px" }
      },
      "label": {
        "sm": { "$value": "0.75rem" },
        "md": { "$value": "0.875rem" },
        "lg": { "$value": "1rem" }
      }
    },

    "icon": {
      "size": {
        "xs": { "$value": "{size.xs}" },
        "sm": { "$value": "{size.sm}" },
        "md": { "$value": "{size.md}" },
        "lg": { "$value": "{size.lg}" },
        "xl": { "$value": "{size.xl}" }
      }
    }
  },

  "variant": {
    "filled": { "$value": "filled" },
    "outlined": { "$value": "outlined" },
    "ghost": { "$value": "ghost" }
  }
}